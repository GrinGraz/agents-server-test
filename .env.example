# Copia este archivo a .env y completa los valores. .env esta en .gitignore.

# Proveedor del modelo: "anthropic" u "ollama"
MODEL_PROVIDER=anthropic

# Si usas Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Si usas Ollama (uv sync --extra ollama)
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
